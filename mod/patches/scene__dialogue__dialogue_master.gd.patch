+
+## The most recent host position that arrived before this machine had opened
+## its dialogue box. Applied as soon as the batch starts, so a follower catches
+## up instead of sitting there waiting for a click that already happened.
+var pending_state: Array = []
+
+
+func Advance() -> void :
+	if not dialogue_active: return
+	if dialogue_label.visible_ratio < 1.0:
+		ProcessRevealText(true)
+		batch_sentence_finished.emit()
+	else:
+		NextSentence()
+
+
+## Snap this machine to the host's exact dialogue position.
+func SyncDialogueState(idx: int, active: bool, revealed: bool) -> void :
+	if not dialogue_active:
+		pending_state = [idx, active, revealed]
+		return
+	if not active:
+		EndBatchNow()
+		return
+	## Guarded loop -- never trust a remote index to terminate this on its own.
+	var steps: int = 0
+	while sentence_index < idx and dialogue_active and steps < 128:
+		steps += 1
+		NextSentence()
+	if not dialogue_active: return
+	if revealed and dialogue_label.visible_ratio < 1.0:
+		ProcessRevealText(true)
+
+
+func ApplyPendingState() -> void :
+	if pending_state.is_empty(): return
+	var s: Array = pending_state
+	pending_state = []
+	SyncDialogueState(s[0], s[1], s[2])
+
+
+## Ends the current batch regardless of `accepting_user_input`. The plain
+## Skip() respects that flag, which could leave a follower stuck forever.
+func EndBatchNow() -> void :
