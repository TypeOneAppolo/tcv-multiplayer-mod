+
+
+var net_dub: bool = false
+var my_dub_slot: int = 0
+var dub_player_count: int = 1
+var character_picker: Control
+
+
+func _is_my_clip(index: int) -> bool:
+	if not net_dub: return true
+	return _owner_slot_of_clip(index) == my_dub_slot
+
+
+# the host resolves one owner per clip and sends it with dub_begin. until that
+# lands, and for packs that tag no characters at all, deal them out in turn.
+func _owner_slot_of_clip(index: int) -> int:
+	if index >= 0 and index < Net.dub_clip_owners.size(): return Net.dub_clip_owners[index]
+	return index % dub_player_count
+
+
+func _clip_characters() -> Array:
+	var out: Array = []
+	for mi: OmniClipMemberInstance in performance_array: out.append(mi.shared_omniclip.dub_characters)
+	return out
+
+
+func _all_characters() -> PackedStringArray:
+	var seen: PackedStringArray = []
+	for mi: OmniClipMemberInstance in performance_array:
+		for character: String in mi.shared_omniclip.dub_characters:
+			if not character.is_empty() and not seen.has(character): seen.append(character)
+	return seen
+
+
+func _show_character_picker() -> void :
+	var picker: Control = preload("res://net/dub_character_picker.gd").new()
+	picker.characters = _all_characters()
+	picker.begin_requested.connect(_begin_from_idle)
+	character_picker = picker
+	add_child(picker)
+
 
 
