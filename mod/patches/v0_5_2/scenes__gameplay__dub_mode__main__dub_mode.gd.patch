+func _on_remote_watch(playing: bool) -> void :
+	# still building the results screen. dub_finished() would paint straight over
+	# the video, so take this when we get there instead.
+	if not net_ready_to_watch:
+		Net.latch_dub_watch(playing)
+		return
+	if playing: _do_watch()
+	else: _do_stop()
+
+
+# the results screen is finally up. say so, and take a watch that landed while
+# this machine was still scoring.
+func _net_finished_dubbing() -> void :
+	if not net_dub: return
+	net_ready_to_watch = true
+	Net.report_dub_finished()
+	var pending: int = Net.take_pending_dub_watch()
+	if pending > 0: _do_watch()
+	elif pending < 0: _do_stop()
+
